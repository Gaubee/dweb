{
  "name": "@jixo/opendweb-server-binary",
  "version": "0.1.0",
  "description": "dweb self-hostable server binary packaged for npm (darwin-arm64)",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "dweb-server": "./bin/dweb-server.mjs"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "type": "module",
  "scripts": {
    "pack:binary": "node scripts/pack.mjs",
    "test": "node scripts/pack.mjs && node --test --test-force-exit",
    "typecheck": "tsc --noEmit",
    "prepack": "node scripts/pack.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "bin/dweb-server.mjs",
    "scripts/pack.mjs",
    "bin/dweb-server-aarch64-apple-darwin",
    "bin/dweb-server-x86_64-pc-windows-msvc.exe"
  ]
}