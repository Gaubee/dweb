{
  "name": "@dweb/client-sdk",
  "version": "0.1.0",
  "description": "dweb application-level fabric SDK for Node (napi-rs binding)",
  "license": "MIT OR Apache-2.0",
  "main": "index.js",
  "types": "index.d.ts",
  "napi": {
    "binaryName": "dweb",
    "targets": [
      "aarch64-apple-darwin"
    ]
  },
  "scripts": {
    "build": "napi build --platform --release --target aarch64-apple-darwin --no-js",
    "build:debug": "napi build --platform --target aarch64-apple-darwin --no-js",
    "test": "node --test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.7.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  },
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64"
  ]
}